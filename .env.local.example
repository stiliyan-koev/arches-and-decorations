NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dev only: LAN hosts allowed to open `npm run dev` (comma-separated), e.g. 192.168.0.179
# DEV_ALLOWED_ORIGINS=

# Contact form on /about. Without a key the form tells visitors to write on
# Messenger/Viber instead. Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Optional overrides — defaults live in src/lib/mail.ts. CONTACT_EMAIL_TO sends
# somewhere else while testing; CONTACT_EMAIL_FROM overrides the sender, which
# by default is zayavki@ukrasivarna.com on our own verified domain.
# CONTACT_EMAIL_TO=
# CONTACT_EMAIL_FROM=
